<Window x:Class="HabitGameGuard.Views.AppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apps Bloqueados" Height="400" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListView ItemsSource="{Binding Apps}" SelectedItem="{Binding Selected}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding NomeAmigavel}" />
                    <GridViewColumn Header="Processo" DisplayMemberBinding="{Binding NomeProcesso}" />
                    <GridViewColumn Header="Créditos/partida" DisplayMemberBinding="{Binding CreditosPorPartida}" />
                    <GridViewColumn Header="Ativo" DisplayMemberBinding="{Binding Ativo}" />
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Adicionar" Width="80" Margin="5" Click="Adicionar_Click" />
            <Button Content="Editar" Width="80" Margin="5" Click="Editar_Click" />
            <Button Content="Remover" Width="80" Margin="5" Click="Remover_Click" />
        </StackPanel>
    </Grid>
</Window>
